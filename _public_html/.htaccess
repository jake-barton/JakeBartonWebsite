# Enable URL Rewriting
RewriteEngine On

# Keep original Mario Kart links working after the project-library move.
RewriteRule ^MarioKartLatest(?:/(?:index\.(?:html|php))?)?$ /games/mario-kart/ [R=301,L,NC]

# Redirect index.php to /home in browser
RewriteCond %{THE_REQUEST} ^GET.*index\.php [NC]
RewriteRule ^index\.php$ /home [R=301,L]

# Internally route /home to index.php
RewriteRule ^home$ index.php [L]

# The visual editor is retired. These rules also block stale server copies.
RewriteRule ^(?:studio|review)(?:/|$) - [R=404,L,NC]
RewriteRule ^includes/(?:cms\.php$|cms-components(?:/|$)|work-detail-page\.php$|project-blueprint\.json$) - [R=404,L,NC]
RewriteRule ^assets/(?:css/studio\.css|js/studio(?:-preview-bridge)?\.js)$ - [R=404,L,NC]

# Withdrawn projects stay private even if a stale server copy exists.
RewriteRule ^work/(?:minnies-golf|wrappt|river|barton-enterprises|campusconnect|psengine|macbook-golf-simulator|october-assistant|artist-campaigns|banking-concurrency-lab|campaign-design)(?:/|$) - [R=404,L,NC]
RewriteRule ^assets/(?:work/minnies-golf(?:/|$)|organizations/minnies\.svg$|source/minnies-score\.txt$) - [R=404,L,NC]

# Project pages are ordinary work/<project-name>/index.php files.

# Remove .php extension from URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# Force HTTPS (uncomment when on live server)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Prevent CSS/JS caching during development (remove in production)
<FilesMatch "\.(css|js)$">
    FileETag None
    <IfModule mod_headers.c>
        Header unset ETag
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </IfModule>
</FilesMatch>
